{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "py -3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\" || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\"; exit 0",
                        "async": true,
                        "timeout": 10
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "py -3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\" || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\"; exit 0",
                        "async": true,
                        "timeout": 10
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "command": "py -3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\" || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\"; exit 0",
                        "async": true,
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "command": "py -3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\" || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\"; exit 0",
                        "async": true,
                        "timeout": 10
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "py -3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\" || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\"; exit 0",
                        "async": true,
                        "timeout": 10
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "permission_prompt|elicitation_dialog",
                "hooks": [
                    {
                        "type": "command",
                        "command": "py -3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\" || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\"; exit 0",
                        "async": true,
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "py -3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\" || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\"; exit 0",
                        "async": true,
                        "timeout": 10
                    }
                ]
            }
        ],
        "StopFailure": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "py -3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\" || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\"; exit 0",
                        "async": true,
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "py -3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\" || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/nuff_pulse_cc.py\"; exit 0",
                        "timeout": 2
                    }
                ]
